# Local development only. Replace secrets before any non-local deployment.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

POSTGRES_DB=mes
POSTGRES_USER=mes
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgres://mes:local-only-change-me@localhost:5432/mes
DATABASE_READ_URL=postgres://mes:local-only-change-me@localhost:5432/mes
JWT_SECRET=local-development-only-replace-with-a-random-secret

OTEL_SERVICE_NAME=mes-api
OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=

RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
WEB_ORIGIN=http://localhost:8080
TRUST_PROXY=
